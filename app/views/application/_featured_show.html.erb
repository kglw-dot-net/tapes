<%
  recordings_count = show.recordings.where(is_active: true).count
  seconds = show.setlists.map { |setlist| setlist.set_songs.sum(:duration) }.sum
  minutes = (seconds / 60).floor
  hours = (minutes / 60).floor
%>
<!--<%#= format('%01d', hours) %>hr<%#= format('%02d', minutes % 60) %>-->

<a class="card card-side bg-white hover:bg-gray-100 dark:bg-black dark:hover:bg-gray-900 shadow-lg transition-all hover:shadow-xl mx-5 mb-2 cursor-pointer"
   href="/<%= show.slug %>"
   data-favourites-target="featuredShow"
   data-turbo-frame="_top">
  <figure class="w-1/5">
    <img src="<%= show.poster_url || (asset_path 'missing.png') %>" class="h-full object-cover" />
  </figure>
  <div class="card-body justify-center py-0">
    <h2 class="featured-item-heading text-black dark:text-white">
      <%= show.date %>
      <%= raw '<br />' if show.title.present? %>
      <%= show.title %>
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5"
           stroke="currentColor" class="size-6 favourite-icon active inline hidden">
        <path stroke-linecap="round" stroke-linejoin="round"
              d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12Z"/>
      </svg>
    </h2>
    <span class="text-sm"><%= show.venue.name.split(' at ').first  %><br/><%= raw show.venue.city %></span>
    <%#= raw [show.venue.city, show.venue.region, show.venue.country.name].reject { |s| s.blank? }.join(', ') %>
    <div class="float-end text-black dark:text-white flex flex-col absolute right-4 items-end text-sm h-full justify-evenly">
        <span class="flex gap-3">
          <%= recordings_count %>
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6 text-primary">
            <path stroke-linecap="round" stroke-linejoin="round" d="M 13.250569,17.659453 H 7.2505695 c -1.2426414,0 -3.2426407,3.5 -2,3.5 h 9.9999995 c 1.623233,0 -0.684717,-3.5 -2,-3.5 z m -8.2499995,-5 c 0,-1 1.5,-1 1.5,0 0,1 -1.5,1 -1.5,0 z m 8.9999995,0 c 0,-1 1.5,-1 1.5,0 0,1 -1.5,1 -1.5,0 z m -3.75,-5.624998 c -2.7079995,0 -5.3629995,0.224 -7.9479995,0.655 -1.053,0.175 -1.802,1.102 -1.802,2.169 v 9.176 c 0,1.242641 1.0073593,2.25 2.25,2.25 H 17.750569 c 1.242641,0 2.25,-1.007359 2.25,-2.25 v -9.176 c 0,-1.067 -0.75,-1.994 -1.801999,-2.169 -2.626765,-0.4369218 -5.285147,-0.6560008 -7.948001,-0.655 z"/>
          </svg>
        </span>

      <% if seconds > 0 %>
          <span class="flex gap-3">
            <%= format('%01d', hours) %>hr<%= format('%02d', minutes % 60) %>
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6 text-secondary">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"/>
            </svg>
          </span>
      <% end %>

      <% unless show.average_rating.nil? or show.count_ratings < 3 %>
          <span class="flex gap-3">
            <%= format('%.1f', show.average_rating) %>
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-6 text-warning">
              <path fill-rule="evenodd" d="M10.788 3.21c.448-1.077 1.976-1.077 2.424 0l2.082 5.006 5.404.434c1.164.093 1.636 1.545.749 2.305l-4.117 3.527 1.257 5.273c.271 1.136-.964 2.033-1.96 1.425L12 18.354 7.373 21.18c-.996.608-2.231-.29-1.96-1.425l1.257-5.273-4.117-3.527c-.887-.76-.415-2.212.749-2.305l5.404-.434 2.082-5.005Z" clip-rule="evenodd"/>
            </svg>
          </span>
      <% end %>
    </div>
  </div>
</a>
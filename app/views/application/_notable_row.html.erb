<%
    show = set_song.setlist.show
    venue = set_song.setlist.show.venue

    minutes = 0
    seconds = 0

    unless set_song.duration.nil?
        minutes = (set_song.duration / 60).floor
        seconds = set_song.duration % 60
    end

    hide_song_name = false if local_assigns[:hide_song_name].nil?
 %>

<a
    class="
    flex 
    cursor-pointer 
    justify-between 
    mb-3 lg:mb-1 
    py-1 lg:py-0
    hover:bg-base-200 transition 
    rounded 
    items-center"
    href="/<%= set_song.setlist.show.slug %>"
>
  <span class="h-[2.875rem] hidden lg:block h-32 my-4 w-8 mx-4">
    <img class="h-full mx-auto rounded" src="<%= show.poster_url.blank? ? asset_path('missing.png') : show.poster_url %>" />
  </span>

  <span class="pr-8 py-2 whitespace-nowrap <% if hide_song_name %> grow <% else %> w-1/3 hidden lg:grid <% end %>">
    <span class="block text-black dark:text-white truncate"><%= show.date.strftime("%Y-%m-%d") %><%=raw '&mdash;' unless show.title.blank? %><%= show.title %></span>
    <span class="block text-sm truncate"><%= CGI.unescapeHTML [venue.name, venue.city, venue.region, venue.country.name].reject(&:blank?).join(', ') %></span>
  </span>

  <span class="w-16 align-argh pl-3 text-sm">#<%= set_song.position %>&nbsp;</span>

  <% unless hide_song_name %>
    <span class="align-middle grow">
      <span class="text-lg text-black dark:text-white"><%= set_song.song.name %></span>
      <span class="lg:hidden">
        <br />
        <span class="text-sm"><%= show.date.strftime("%Y-%m-%d") %><%=raw '&mdash;' unless show.title.blank? %><%= show.title %></span> &bull;
        <span class="text-sm"><%= CGI.unescapeHTML [venue.name, venue.city, venue.region, venue.country.name].reject(&:blank?).join(', ') %></span>
      </span>
    </span>
  <% end %>

  <% unless local_assigns[:extra_html].nil? %>
    <span class="w-2/5 align-middle text-sm pr-3 hidden lg:block">
      <%= raw extra_html %>
    </span>
  <% end %>

  <% if local_assigns[:show_upvotes] %>
    <span class="w-16 align-middle text-sm pr-3">
      <% if set_song.upvotes > 0  %>
        <div class="flex float-end lg:mr-3">
          <span class="leading-6 mr-1">
            <%= set_song.upvotes %>
          </span>

          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6 text-primary">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 10.5 12 3m0 0 7.5 7.5M12 3v18" />
          </svg>
        </div>
       <% end %>
    </span>
  <% end %>

  <span class="w-16 align-middle text-sm text-end pr-3"><%= format('%02d', minutes) %>:<%= format('%02d', seconds) %></span>
</a>

<% unless local_assigns[:extra_html].nil? or local_assigns[:extra_html].blank? %>
  <div class="block lg:hidden mb-8 px-4">
    <%= raw extra_html %>
  </div>
<% end %>

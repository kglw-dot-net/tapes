<% content_for :meta_title, "Side Projects on Gizz Tapes" %>

<div class="container mx-auto mt-8 px-5">
  <h2 class="text-3xl font-bold mb-3 text-center text-black dark:text-white">Side Project Shows by Artist</h2>
  <h3 class="text-2xl font-bold mb-8 text-center">Total Shows: <%= @artists.sum { |a| a[:show_count] } %></h3>

  <div class="responsive-grid bg-base-100 rounded-xl shadow-xl p-5">
    <% @artists.each do |a| %>
      <a href="<%= url_for a %>" class="featured-item">
        <div class="indicator w-full">
          <img src="<%= a[:poster_url].blank? ? asset_path('missing.png') : a[:poster_url] %>" />
        </div>

        <h4 class="text-primary mt-1"><%= a %></h4>
        <small><%= a[:show_count] %> show<%= 's' unless a[:show_count] == 1 %></small>
      </a>
    <% end %>
  </div>
</div>

<% if @shows.any? %>
  <div class="card bg-base-100 shadow-xl mb-5">
    <div class="card-body pb-0 pt-5 px-3">
      <h3 class="card-title mb-2 text-black dark:text-white flex px-2">
        <span class="grow">Today in Gizztory&mdash;<%= @day_text %></span>
        <a href="<%= @day_url %>" class="text-end text-primary">&raquo; View all</a>
      </h3>

      <div class="horizontal-scroll lg:responsive-grid text-center pb-3">
        <% @shows.each do |show| %>
          <%= render "featured_show", show: show %>
        <% end %>
      </div>
    </div>
  </div>
<% end %>
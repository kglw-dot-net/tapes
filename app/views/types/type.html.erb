<% content_for :meta_title, "#{@set_type.name}s on Gizz Tapes" %>

<div class="bg-page">
  <div class="container mx-auto pt-16 px-5">
    <h2 class="text-3xl font-bold mb-3 text-center text-black dark:text-white">
      <%= @set_type.name %>s
    </h2>

    <h3 class="text-2xl font-bold mb-16 text-center">
      <%= @shows.length %> show<%= 's' unless @shows.length == 1 %>
    </h3>

    <div class="responsive-grid" style="grid-template-columns: repeat(2, minmax(0, 1fr)) !important;">
      <% @shows.each do |show| %>
        <%= render "featured_show", show: show %>
      <% end %>
    </div>
  </div>
</div>